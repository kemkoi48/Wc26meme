# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Robinhood Agentic Trading OAuth access token (bearer) for
# https://agent.robinhood.com/mcp/trading
# Obtain via Robinhood's Agentic Trading authorization flow.
ROBINHOOD_ACCESS_TOKEN=

# Anthropic credentials for the Claude Agent SDK.
# Optional here if you already authenticate via `ant auth login` / Claude Code login.
ANTHROPIC_API_KEY=
