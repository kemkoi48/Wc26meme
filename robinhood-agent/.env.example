# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Robinhood Agentic Trading OAuth access token (bearer) for
# https://agent.robinhood.com/mcp/trading
# Obtain via Robinhood's Agentic Trading authorization flow.
ROBINHOOD_ACCESS_TOKEN=

# The brokerage account the bot may act on. Must be an account with
# agentic_allowed=true (your "Agentic" account). Kept here, not in the committed
# config, so your account id stays out of git. The risk guard denies any order
# aimed at a different account.
ROBINHOOD_ACCOUNT_NUMBER=

# Anthropic credentials for the Claude Agent SDK.
# Optional here if you already authenticate via `ant auth login` / Claude Code login.
ANTHROPIC_API_KEY=

# Stocklake Pro API key for insider activity and market research.
# Used by stocklake_screener.py to verify catalysts and detect insider trading signals.
# Obtain from https://stocklake.com (Pro tier required).
STOCKLAKE_API_KEY=
